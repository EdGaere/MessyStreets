{  
    table : { 
        name : "Table 1 (N=100)"

        "sort": {
            "columns": [
                "Found",
                "Geohash 1 (+/- 2'500 km)",
                "Geohash 4 (+/- 20 km)",
                "Geohash 6 (+/- 0.6 km)"
            ],
            "ascending": false
        }

    }

    format : {
        decimals : 1

        caption : "Recall and accuracy of Geocoder APIs on MESSY STREETS Gold Tier. Each Geocoder is run 10 times. Recall is shown in column Found, accuracy is measured at 3 precision levels in the columns Geohash 1, 4 and 6. Each run draws a fresh set of 100 addresses; the set is identical for all libraries and all models for direct comparison. Mean +/-2 SEM computed over the 10 runs, 1,000 addresses in total. Rows sorted by descending recall then accuracy. Best result in bold."


        # reference the table in the Latex document using see Tables \ref{datetime_translation}
        label : "address_gold_2"
    }

    tables : [
        "messy_streets/release-gold-2/run1"
        "messy_streets/release-gold-2/run2"
        "messy_streets/release-gold-2/run3"
