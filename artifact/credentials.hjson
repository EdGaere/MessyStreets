/*
  MESSY STREETS — geocoder credentials.

  This file is a TEMPLATE. It ships empty and should stay that way: fill in a
  copy that lives outside the repository, so no git operation can ever reach it.

      messy-streets credentials --set here      prompts, writes 0600, no echo
      messy-streets credentials                 shows what is set, never a value
      messy-streets credentials --check         one live call each, finds bad keys

  By default those write to and read from

      ~/.config/messy-streets/credentials.hjson

  Point at a different file with --credentials, or MS_CREDENTIALS:

      ./messy-streets geocode --credentials ~/.config/messy-streets/mine.hjson

  A key left null means that provider is simply not queried. Nominatim, Photon
  and ArcGIS need no key at all, so the open-source geocoders the paper's
  findings concern work with this file completely empty.

  Environment variables win over this file, so CI and one-off overrides need no
  edit here.
*/
{
  geocoders:
  {
    // Nominatim, Photon and ArcGIS are absent deliberately: they need no key.

    // console.cloud.google.com -> Geocoding API
    GOOGLE_MAPS_API_KEY: null

    // platform.here.com
    HERE_API_KEY: null

    // account.mapbox.com/access-tokens
    MAPBOX_API_KEY: null

    // portal.azure.com -> Azure Maps -> Authentication
    AZURE_MAPS_API_KEY: null

    // opencagedata.com/dashboard
    OPENCAGE_API_KEY: null

    // developer.tomtom.com
    TOMTOM_API_KEY: null

    // myprojects.geoapify.com
    GEOAPIFY_MAPS_API_KEY: null

    // developer.mapquest.com
    MAPQUEST_API_KEY: null

    // geocode.earth  (Pelias)
    GEOCODE_EARTH_API_KEY: null
  }
}
