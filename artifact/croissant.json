      "@id": "gold-tier",
      "name": "gold-tier",
      "description": "10,000 verbatim web addresses, each verified to exist against OpenAddresses or OpenStreetMap, with street, country and postcode individually validated. 10,000 records.",
      "contentUrl": "data/tiers/gold.jsonl.gz",
      "encodingFormat": "application/jsonlines+gzip",
      "sha256": "532cc4a8ebb7a9da743adfd53b79eaaf39ccb0911dffe561c7ba20c00cc0a07a"
    },
    {
      "@type": "sc:FileObject",
      "@id": "silver-tier",
      "name": "silver-tier",
      "description": "10,000 existence-verified addresses whose individual components are not validated. Same construction as the gold tier without the component judge. 10,000 records.",
      "contentUrl": "data/tiers/silver.jsonl.gz",
      "encodingFormat": "application/jsonlines+gzip",
      "sha256": "5349fd11207481ba8c895e87805b860a79aee0e571c88f797aabc9fe7cbe2f02"
    },
    {
      "@type": "sc:FileObject",
      "@id": "raw-tier",
      "name": "raw-tier",
      "description": "10,000 addresses requiring only a street component. Neither existence-verified nor component-validated; released for reference. 10,000 records.",
      "contentUrl": "data/tiers/raw.jsonl.gz",
      "encodingFormat": "application/jsonlines+gzip",
      "sha256": "1fa72a1e970ba87adcf2e65a52466ffcd2021e2cc34babfa4f942a6a771b0006"
    }
  ],
